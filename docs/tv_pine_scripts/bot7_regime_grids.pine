//@version=5
// bot7 · режим сеток v2.5 (25.10.2026) — то, по чему реально работают боты WEEX, вместо прогноза направления.
// v2.5 (аудит GPT 481385e A5): ближайший вход/тейк — по расстоянию до цены; уровни старше «устарели через, ч» — серым
// с пометкой «снимок N ч назад»; подпись WEEX; средняя — без комиссий и фандинга.
// v2.4 (оператор: «чтобы средняя постоянно была на графике»): SMA100 и средняя лотов рисуются всегда, независимо от
// лимита расстояния, с подписью у правого края (галочка «SMA и средняя лотов — всегда»); остальные дальние линии — как раньше.
// v2.3 (разбор GPT к a25c763): алерты, метки и подсветка режима — только при расчёте по правилу ботов (BINANCE спот,
// SMA100); подпись входов — на ближайшем (видимом) входе, а не на самом нижнем.
// v2.1: «дней в режиме» убрано (ничего не решает) → «запас до порога» в дневных размахах ATR(14).
// v2.2 (разбор GPT 8252cc0): полнота учёта (g/x) и конец окна прогноза (w) из строки бота — истёкший коридор не
// рисуется; «средняя лотов, без комиссий» вместо «безубыток»; «режим разрешает LONG» (расчёт, не подтверждение работы
// процесса); фильтр дальних линий — для всех уровней; расстояние до ближайшего входа и тейка; размер текста.
// Режим = правило движка (services/weex_grid/engine.py, regime_up): закрытие ВЧЕРАШНЕГО дня UTC на BINANCE спот
// выше средней 100 закрытых дней → лонги разрешены; ниже → на следующий день лонги закрываются по рынку.
// Порог сегодняшнего закрытия = средняя 99 последних закрытых дней (как research/weex/account_now.py).
// Сверка 21.10: BTC SMA100 74,615 / порог 74,739; ETH 2,291.42 / 2,296.62.
// Уровни бота — одной строкой из Telegram (/tv или сообщение после утренней карточки, services/tv_levels.py):
// одна и та же строка на всех графиках, индикатор берёт часть своей монеты. TradingView сам данные с мака не читает.
// Ставить на ТФ от 1м до 1D.
indicator("bot7 · режим сеток", overlay=true, max_lines_count=80, max_labels_count=120)

inBot    = input.string("", "Строка из бота (/tv)", tooltip="Telegram: /tv или сообщение после утренней карточки. Одна строка на все графики")
srcMode  = input.string("авто", "Дневки для режима", options=["авто", "график"], tooltip="авто: BTC/ETH — BINANCE спот, как у ботов; остальное — дневки графика (справочно, ботов на нём нет)")
smaLen   = input.int(100, "SMA, дней (боты: 100)", minval=10)
showLine = input.bool(true, "Линии SMA и порога")
lineMax  = input.float(6.0, "Рисовать линии, если до цены не дальше, %", minval=0.5, step=0.5, tooltip="Для порога и уровней бота (SMA и средняя лотов — см. галочку ниже). Дальние сжимают свечи; цифры всё равно в таблице")
avgAlways = input.bool(true, "SMA и средняя лотов — всегда (даже дальше лимита)", tooltip="v2.4: обе средние видны постоянно. Далёкая SMA сжимает свечи — тогда снять галочку или открыть ТФ крупнее")
staleH   = input.float(12.0, "Уровни бота устарели через, ч", minval=1, step=1, tooltip="v2.5: старше — входы/тейки/средняя серым с пометкой «снимок N ч назад»: это не подтверждённые стоящие сейчас заявки")
showBg   = input.bool(true, "Подсветка режима (зелёный — лонги разрешены, серый — нет)")
warnPct  = input.float(3.0, "Красный и тревога: до порога меньше, %", minval=0.1, step=0.5)
showTp   = input.bool(true, "Ближайшие тейки сеток")
showCG   = input.bool(false, "Зоны CoinGlass (исследование)", tooltip="v2.5 (аудит GPT A5): шанс у зоны — историческая частота касания при таком расстоянии/ATR от якоря утра до конца окна; сила зоны CoinGlass в нём не участвует, добавочная польза карты не доказана. Не магнит и не сигнал")
tabPos   = input.string("сверху справа", "Таблица", options=["сверху справа", "снизу справа", "сверху слева", "снизу слева"])
txtSize  = input.string("мелкий", "Размер текста", options=["мелкий", "обычный", "крупный"])

tsz   = txtSize == "крупный" ? size.large : txtSize == "обычный" ? size.normal : size.small
base  = syminfo.basecurrency
isBot = base == "BTC" or base == "ETH"
sym   = srcMode == "авто" and isBot ? "BINANCE:" + base + "USDT" : syminfo.tickerid
asBot = isBot and srcMode == "авто" and smaLen == 100              // расчёт совпадает с правилом ботов

// ── дневки: значения ВЧЕРАШНЕГО закрытого дня (lookahead_on + [1] — без перерисовки)
f_daily() =>
    s100  = ta.sma(close, smaLen)
    s99   = ta.sma(close, smaLen - 1)
    up    = close > s100                       // решение на закрытии этого дня, действует со следующего
    [s100[1], s99[1], up[1], ta.atr(14)[1]]

[ySma, thr, regUp, atrD] = request.security(sym, "D", f_daily(), lookahead=barmerge.lookahead_on)

dSma = ySma > 0 ? (close / ySma - 1) * 100 : na
dThr = thr > 0 ? (thr / close - 1) * 100 : na
near = asBot and not na(dThr) and math.abs(dThr) < warnPct        // алерт — только по правилу ботов (v2.3)

// ── линии и подсветка
plot(showLine and not na(dSma) and (avgAlways or math.abs(dSma) <= lineMax) ? ySma : na, "SMA дн. (вчера)", color.new(color.aqua, 0), 2, plot.style_stepline)
plot(showLine and not na(dThr) and math.abs(dThr) <= lineMax ? thr : na, "Порог закрытия сегодня", color.new(color.orange, 0), 1, plot.style_stepline)
// подсветка, метки и алерт смены режима — только когда расчёт совпадает с правилом ботов (asBot): при SMA50 или
// дневках графика это справочный расчёт, а не смена SMA100-режима ботов (разбор GPT к a25c763)
bgcolor(showBg and asBot and not na(ySma) ? (regUp ? color.new(color.green, 93) : color.new(color.gray, 88)) : na)
flipOn  = asBot and not na(ySma[1]) and regUp and not regUp[1]
flipOff = asBot and not na(ySma[1]) and not regUp and regUp[1]
plotshape(flipOn,  "Лонги разрешены", shape.labelup,   location.belowbar, color.new(color.green, 0), text="лонги вкл",      textcolor=color.white, size=size.small)
plotshape(flipOff, "Лонги закрыты",   shape.labeldown, location.abovebar, color.new(color.gray, 0),  text="лонги закрыты", textcolor=color.white, size=size.small)

// ── формат и разбор строки бота
f_px(v) => na(v) ? "—" : v >= 10000 ? str.tostring(v, "#,##0") : str.tostring(v, "#,##0.00")
f_pct(v) => na(v) ? "—" : (v >= 0 ? "+" : "") + str.tostring(v, "0.0") + "%"
f_near(p) => math.abs(p / close - 1) * 100 <= lineMax

f_part(s) =>
    string res = ""
    for p in str.split(s, "|")
        t = str.trim(p)
        if str.startswith(t, base + " ")
            res := t
    res

f_list(body, arr) =>
    for x in str.split(body, ",")
        v = str.tonumber(x)
        if not na(v) and v > 0
            array.push(arr, v)
    array.size(arr)

var line[]  gLines  = array.new_line()
var label[] gLabels = array.new_label()
var linefill gFill  = na

f_level(lns, lbs, price, txt, col, sty) =>
    l = line.new(bar_index - 1, price, bar_index, price, extend=extend.right, color=col, style=sty, width=1)
    array.push(lns, l)
    if str.length(txt) > 0
        array.push(lbs, label.new(bar_index + 2, price, txt, style=label.style_label_left, color=color.new(color.black, 100), textcolor=col, size=tsz))
    l

f_span(arr) => array.size(arr) == 1 ? f_px(array.get(arr, 0)) : f_px(array.min(arr)) + "–" + f_px(array.max(arr))

// v2.5 (аудит GPT A5): ближайший к текущей цене уровень — по модулю расстояния (max/min верны, только пока все уровни
// по одну сторону цены)
f_nearest(arr) =>
    float best = na
    for v in arr
        if na(best) or math.abs(v - close) < math.abs(best - close)
            best := v
    best

// ── таблица
pos = tabPos == "сверху справа" ? position.top_right : tabPos == "снизу справа" ? position.bottom_right : tabPos == "сверху слева" ? position.top_left : position.bottom_left
var table T = table.new(pos, 2, 9, border_width=1)

f_row(t, r, k, v, vc) =>
    table.cell(t, 0, r, k, text_color=color.silver, bgcolor=color.new(color.black, 45), text_size=tsz, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, bgcolor=color.new(color.black, 45), text_size=tsz, text_halign=text.align_left)

if barstate.islast
    // разбор строки бота: u время, g прочитано/ожидалось сеток, x непрочитанные, k коридор, w конец окна прогноза,
    // z зоны цена:шанс, e входы, t тейки, a средняя лотов без комиссий, n лотов, s порог бота
    float u    = na
    float vOk  = na
    float kLo  = na
    float kHi  = na
    float wEnd = na
    float aAvg = na
    float sThr = na
    float nLot = na
    int gRead  = na
    int gExp   = na
    string xMiss = ""
    zp  = array.new_float()
    zc  = array.new_float()
    ent = array.new_float()
    tps = array.new_float()
    part = f_part(inBot)
    for tok in str.split(part, " ")
        if str.length(tok) > 1
            pre  = str.substring(tok, 0, 1)
            body = str.substring(tok, 1)
            if pre == "u"
                u := str.tonumber(body)
            else if pre == "v"
                vOk := str.tonumber(body)
            else if pre == "g"
                gg = str.split(body, "/")
                if array.size(gg) == 2
                    gRead := int(str.tonumber(array.get(gg, 0)))
                    gExp  := int(str.tonumber(array.get(gg, 1)))
            else if pre == "x"
                xMiss := body
            else if pre == "k"
                kk = str.split(body, "-")
                if array.size(kk) == 2
                    kLo := str.tonumber(array.get(kk, 0))
                    kHi := str.tonumber(array.get(kk, 1))
            else if pre == "w"
                wEnd := str.tonumber(body)
            else if pre == "z"
                for zt in str.split(body, ",")
                    zz = str.split(zt, ":")
                    zpv = array.size(zz) >= 1 ? str.tonumber(array.get(zz, 0)) : na
                    if not na(zpv)
                        array.push(zp, zpv)
                        array.push(zc, array.size(zz) >= 2 ? str.tonumber(array.get(zz, 1)) : na)
            else if pre == "e"
                f_list(body, ent)
            else if pre == "t"
                f_list(body, tps)
            else if pre == "a"
                aAvg := str.tonumber(body)
            else if pre == "n"
                nLot := str.tonumber(body)
            else if pre == "s"
                sThr := str.tonumber(body)
    expired  = not na(wEnd) and timenow / 1000 > wEnd               // окно прогноза кончилось — коридор не действует
    partial  = not na(gRead) and not na(gExp) and gRead < gExp

    // уровни на графике (дальние — только в таблице)
    for l in gLines
        line.delete(l)
    array.clear(gLines)
    for lb in gLabels
        label.delete(lb)
    array.clear(gLabels)
    if not na(gFill)
        linefill.delete(gFill)
    if not na(kLo) and not na(kHi) and not expired and f_near(kLo) and f_near(kHi)
        lLo = f_level(gLines, gLabels, kLo, "коридор дня (ATR-история) · низ " + f_px(kLo), color.new(color.teal, 0), line.style_dashed)
        lHi = f_level(gLines, gLabels, kHi, "коридор дня (ATR-история) · верх " + f_px(kHi), color.new(color.teal, 0), line.style_dashed)
        gFill := linefill.new(lLo, lHi, color.new(color.teal, 94))
    if showCG and not expired                                     // v2.5: зоны CoinGlass — только по галочке
        for [i, p] in zp
            if f_near(p)
                c = array.get(zc, i)
                f_level(gLines, gLabels, p, (p >= close ? "↑ зона CG " : "↓ зона CG ") + f_px(p) + (na(c) ? "" : " · касание " + str.tostring(c, "0") + "% по ATR от утра, сила зоны не учтена"), color.new(color.fuchsia, 0), line.style_dotted)
    // v2.5 (аудит GPT A5): уровни бота — снимок учёта на момент последней сверки с биржей (v; нет v — время строки u),
    // не подтверждённые стоящие сейчас заявки. Старше staleH или сверка неизвестна (v0) — серым с пометкой; биржа —
    // WEEX (на графике Bybit/Binance это явно подписано)
    syncT  = na(vOk) ? u : vOk
    unk    = not na(vOk) and vOk <= 0
    ageNow = na(syncT) or unk ? na : (timenow / 1000 - syncT) / 3600
    stale  = unk or (not na(ageNow) and ageNow > staleH)
    tag    = unk ? "сверка неизвестна · " : stale ? "снимок " + str.tostring(ageNow, "0") + " ч назад · " : ""
    cEnt   = stale ? color.new(color.gray, 30) : color.new(color.lime, 40)
    cTp    = stale ? color.new(color.gray, 30) : color.new(color.red, 40)
    cAvg   = stale ? color.new(color.gray, 0) : color.new(color.yellow, 0)
    if array.size(ent) > 0
        for p in ent
            if f_near(p)
                f_level(gLines, gLabels, p, "", cEnt, line.style_dotted)
        eNear = f_nearest(ent)                                  // ближайший к цене вход — по расстоянию, а не max
        if f_near(eNear)
            array.push(gLabels, label.new(bar_index + 2, eNear, tag + "входы сеток WEEX: " + str.tostring(array.size(ent)) + " (" + f_span(ent) + ") · ближайший " + f_px(eNear) + " " + f_pct((eNear / close - 1) * 100), style=label.style_label_left, color=color.new(color.black, 100), textcolor=stale ? color.gray : color.lime, size=tsz))
    if showTp and array.size(tps) > 0
        for p in tps
            if f_near(p)
                f_level(gLines, gLabels, p, "", cTp, line.style_dotted)
        tNear = f_nearest(tps)
        if f_near(tNear)
            array.push(gLabels, label.new(bar_index + 2, tNear, tag + "тейки сеток WEEX: " + str.tostring(array.size(tps)) + " (" + f_span(tps) + ") · ближайший " + f_px(tNear) + " " + f_pct((tNear / close - 1) * 100), style=label.style_label_left, color=color.new(color.black, 100), textcolor=stale ? color.gray : color.red, size=tsz))
    if not na(aAvg) and (avgAlways or f_near(aAvg))
        f_level(gLines, gLabels, aAvg, tag + "средняя лотов WEEX (без комиссий и фандинга) " + f_px(aAvg) + " · цена " + f_pct((close / aAvg - 1) * 100), cAvg, line.style_solid)
    if showLine and not na(ySma) and (avgAlways or f_near(ySma))     // v2.4: подпись SMA у правого края
        array.push(gLabels, label.new(bar_index + 2, ySma, "SMA" + str.tostring(smaLen) + " дн. " + f_px(ySma) + " · цена " + f_pct(dSma), style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.aqua, size=tsz))

    // таблица
    msLeft = 86400000 - timenow % 86400000
    hh     = math.floor(msLeft / 3600000)
    mm     = math.floor((msLeft % 3600000) / 60000)
    thrCol = na(dThr) ? color.silver : math.abs(dThr) < warnPct ? color.red : math.abs(dThr) < 2 * warnPct ? color.orange : color.lime
    table.cell(T, 0, 0, "bot7 · режим", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=tsz, text_halign=text.align_left)
    src0 = not isBot ? "дневки графика · ботов нет" : asBot ? sym + " · дневки UTC" : "справочно: не правило ботов (у них BINANCE спот, SMA100)"
    table.cell(T, 1, 0, src0, text_color=asBot ? color.silver : color.orange, bgcolor=color.new(color.black, 20), text_size=tsz, text_halign=text.align_left)
    regTxt = na(ySma) ? "мало истории" : isBot ? (regUp ? "режим разрешает LONG" : "режим запрещает LONG") + (asBot ? "" : " (справочно)") : (regUp ? "выше SMA" : "ниже SMA")
    f_row(T, 1, "Режим (расчёт)", regTxt, na(ySma) ? color.silver : not asBot ? color.gray : regUp ? color.lime : color.gray)
    f_row(T, 2, "SMA" + str.tostring(smaLen) + " дн.", f_px(ySma) + " · цена " + f_pct(dSma), color.white)
    sameDay = not na(u) and math.floor(u / 86400) == math.floor(timenow / 86400000)
    botDiff = sameDay and not na(sThr) and not na(thr) and math.abs(sThr / thr - 1) > 0.001
    k3 = isBot ? (regUp ? "Закрытие дня НИЖЕ" : "Закрытие дня ВЫШЕ") : "Порог закрытия дня"
    v3 = f_px(thr) + " (" + f_pct(dThr) + ")" + (isBot ? (regUp ? " → лонги закроются" : " → лонги вкл") : "") + (botDiff ? " ⚠ у бота " + f_px(sThr) : "")
    f_row(T, 3, k3, v3, botDiff ? color.orange : thrCol)
    gap = na(thr) ? na : math.abs(close - thr)
    f_row(T, 4, "Запас до порога", na(gap) or na(atrD) or atrD <= 0 ? "—" : f_px(gap) + " = " + str.tostring(gap / atrD, "0.0") + " дневных размаха (ATR " + f_px(atrD) + ")", thrCol)
    f_row(T, 5, "До закрытия дня UTC", isBot ? str.tostring(hh) + "ч " + str.tostring(mm) + "м" : "—", color.white)
    if not na(kLo) and not na(kHi) and kHi > kLo and not expired
        inPct = (close - kLo) / (kHi - kLo) * 100
        f_row(T, 6, "Коридор дня", f_px(kLo) + "–" + f_px(kHi) + " · цена на " + str.tostring(inPct, "0") + "%", inPct < 0 or inPct > 100 ? color.orange : color.teal)
    else if expired
        f_row(T, 6, "Коридор дня", "прогноз истёк — нужна свежая строка /tv", color.orange)
    else
        f_row(T, 6, "Коридор дня", isBot ? "нет: /tv в Telegram → ⚙ индикатора → «Строка из бота»" : "—", color.gray)
    lotTxt = na(nLot) ? (partial and gRead == 0 ? "учёт не прочитан" : "—") : str.tostring(nLot, "0") + " лот." + (na(aAvg) ? "" : " · средняя без комиссий " + f_px(aAvg) + " (цена " + f_pct((close / aAvg - 1) * 100) + ")")
    f_row(T, 7, "Лоты бота", lotTxt, partial ? color.orange : color.yellow)
    ageH = ageNow                                               // v2.5: от сверки с биржей (v), не от сборки строки
    ageTxt = unk ? "сверка с биржей неизвестна" : na(ageH) ? (isBot ? "строки нет" : "—") : (ageH < 1 ? str.tostring(math.round(ageH * 60)) + " мин назад" : str.tostring(ageH, "0.0") + " ч назад") + (na(vOk) ? " (время строки)" : " (сверка WEEX)")
    covTxt = na(gRead) ? "" : " · сетки " + str.tostring(gRead) + "/" + str.tostring(gExp) + (str.length(xMiss) > 0 ? " (нет " + xMiss + ")" : "")
    f_row(T, 8, "Уровни бота от", ageTxt + covTxt, unk ? color.orange : na(ageH) ? color.gray : partial or stale ? color.orange : color.white)

// оба алерта гейтированы asBot (near, flipOn/flipOff): справочная SMA или другие дневки алерт бота не шлют
alertcondition(near, "bot7: близко к порогу", "Цена близко к порогу закрытия дня по SMA100 — лонг-сетки могут закрыться на следующий день")
alertcondition(flipOn or flipOff, "bot7: смена режима", "Сменился режим SMA100 у сеток")
