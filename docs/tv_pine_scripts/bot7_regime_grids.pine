//@version=5
// bot7 · режим сеток v2.1 (21.10.2026) — то, по чему реально работают боты WEEX, вместо прогноза направления.
// v2.1: «дней в режиме» убрано (ничего не решает) → «запас до порога» в дневных размахах ATR(14).
// Режим = правило движка (services/weex_grid/engine.py, regime_up): закрытие ВЧЕРАШНЕГО дня UTC на BINANCE спот
// выше средней 100 закрытых дней → лонг-сетки работают; ниже → на следующий день лонги закрываются по рынку.
// Порог сегодняшнего закрытия = средняя 99 последних закрытых дней (как research/weex/account_now.py).
// Сверка 21.10: BTC SMA100 74,615 / порог 74,739; ETH 2,291.42 / 2,296.62.
// Уровни бота — одной строкой из Telegram (/tv или сообщение после утренней карточки, services/tv_levels.py):
// одна и та же строка на всех графиках, индикатор берёт часть своей монеты. TradingView сам данные с мака не читает.
// Ставить на ТФ от 1м до 1D.
indicator("bot7 · режим сеток", overlay=true, max_lines_count=80, max_labels_count=120)

inBot    = input.string("", "Строка из бота (/tv)", tooltip="Telegram: /tv или сообщение после утренней карточки. Одна строка на все графики")
srcMode  = input.string("авто", "Дневки для режима", options=["авто", "график"], tooltip="авто: BTC/ETH — BINANCE спот, как у ботов; остальное — дневки графика (справочно, ботов на нём нет)")
smaLen   = input.int(100, "SMA, дней (боты: 100)", minval=10)
showLine = input.bool(true, "Линии SMA и порога")
lineMax  = input.float(6.0, "Рисовать линии, если до цены не дальше, %", minval=0.5, step=0.5, tooltip="Дальние линии сжимают свечи; цифры всё равно в таблице")
showBg   = input.bool(true, "Подсветка режима (зелёный — лонги работают, серый — вне рынка)")
warnPct  = input.float(3.0, "Красный и тревога: до порога меньше, %", minval=0.1, step=0.5)
showTp   = input.bool(true, "Ближайшие тейки сеток")
tabPos   = input.string("сверху справа", "Таблица", options=["сверху справа", "снизу справа", "сверху слева", "снизу слева"])

base  = syminfo.basecurrency
isBot = base == "BTC" or base == "ETH"
sym   = srcMode == "авто" and isBot ? "BINANCE:" + base + "USDT" : syminfo.tickerid

// ── дневки: значения ВЧЕРАШНЕГО закрытого дня (lookahead_on + [1] — без перерисовки)
f_daily() =>
    s100  = ta.sma(close, smaLen)
    s99   = ta.sma(close, smaLen - 1)
    up    = close > s100                       // решение на закрытии этого дня, действует со следующего
    [s100[1], s99[1], up[1], ta.atr(14)[1]]

[ySma, thr, regUp, atrD] = request.security(sym, "D", f_daily(), lookahead=barmerge.lookahead_on)

dSma = ySma > 0 ? (close / ySma - 1) * 100 : na
dThr = thr > 0 ? (thr / close - 1) * 100 : na
near = isBot and not na(dThr) and math.abs(dThr) < warnPct

// ── линии и подсветка
plot(showLine and not na(dSma) and math.abs(dSma) <= lineMax ? ySma : na, "SMA дн. (вчера)", color.new(color.aqua, 0), 2, plot.style_stepline)
plot(showLine and not na(dThr) and math.abs(dThr) <= lineMax ? thr : na, "Порог закрытия сегодня", color.new(color.orange, 0), 1, plot.style_stepline)
bgcolor(showBg and isBot and not na(ySma) ? (regUp ? color.new(color.green, 93) : color.new(color.gray, 88)) : na)
flipOn  = isBot and not na(ySma[1]) and regUp and not regUp[1]
flipOff = isBot and not na(ySma[1]) and not regUp and regUp[1]
plotshape(flipOn,  "Лонги разрешены", shape.labelup,   location.belowbar, color.new(color.green, 0), text="лонги вкл",      textcolor=color.white, size=size.small)
plotshape(flipOff, "Лонги закрыты",   shape.labeldown, location.abovebar, color.new(color.gray, 0),  text="лонги закрыты", textcolor=color.white, size=size.small)

// ── формат и разбор строки бота
f_px(v) => na(v) ? "—" : v >= 10000 ? str.tostring(v, "#,##0") : str.tostring(v, "#,##0.00")
f_pct(v) => na(v) ? "—" : (v >= 0 ? "+" : "") + str.tostring(v, "0.0") + "%"

f_part(s) =>
    string res = ""
    for p in str.split(s, "|")
        t = str.trim(p)
        if str.startswith(t, base + " ")
            res := t
    res

f_list(body, arr) =>
    for x in str.split(body, ",")
        v = str.tonumber(x)
        if not na(v) and v > 0
            array.push(arr, v)
    array.size(arr)

var line[]  gLines  = array.new_line()
var label[] gLabels = array.new_label()
var linefill gFill  = na

f_level(lns, lbs, price, txt, col, sty) =>
    l = line.new(bar_index - 1, price, bar_index, price, extend=extend.right, color=col, style=sty, width=1)
    array.push(lns, l)
    if str.length(txt) > 0
        array.push(lbs, label.new(bar_index + 2, price, txt, style=label.style_label_left, color=color.new(color.black, 100), textcolor=col, size=size.small))
    l

f_span(arr) => array.size(arr) == 1 ? f_px(array.get(arr, 0)) : f_px(array.min(arr)) + "–" + f_px(array.max(arr))

// ── таблица
pos = tabPos == "сверху справа" ? position.top_right : tabPos == "снизу справа" ? position.bottom_right : tabPos == "сверху слева" ? position.top_left : position.bottom_left
var table T = table.new(pos, 2, 9, border_width=1)

f_row(t, r, k, v, vc) =>
    table.cell(t, 0, r, k, text_color=color.silver, bgcolor=color.new(color.black, 45), text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, bgcolor=color.new(color.black, 45), text_size=size.small, text_halign=text.align_left)

if barstate.islast
    // разбор строки бота: u время, k коридор, z зоны цена:шанс, e входы, t тейки, a безубыток лотов, n лотов, s порог бота
    float u    = na
    float kLo  = na
    float kHi  = na
    float aAvg = na
    float sThr = na
    float nLot = na
    zp  = array.new_float()
    zc  = array.new_float()
    ent = array.new_float()
    tps = array.new_float()
    part = f_part(inBot)
    for tok in str.split(part, " ")
        if str.length(tok) > 1
            pre  = str.substring(tok, 0, 1)
            body = str.substring(tok, 1)
            if pre == "u"
                u := str.tonumber(body)
            else if pre == "k"
                kk = str.split(body, "-")
                if array.size(kk) == 2
                    kLo := str.tonumber(array.get(kk, 0))
                    kHi := str.tonumber(array.get(kk, 1))
            else if pre == "z"
                for zt in str.split(body, ",")
                    zz = str.split(zt, ":")
                    zpv = array.size(zz) >= 1 ? str.tonumber(array.get(zz, 0)) : na
                    if not na(zpv)
                        array.push(zp, zpv)
                        array.push(zc, array.size(zz) >= 2 ? str.tonumber(array.get(zz, 1)) : na)
            else if pre == "e"
                f_list(body, ent)
            else if pre == "t"
                f_list(body, tps)
            else if pre == "a"
                aAvg := str.tonumber(body)
            else if pre == "n"
                nLot := str.tonumber(body)
            else if pre == "s"
                sThr := str.tonumber(body)

    // уровни на графике
    for l in gLines
        line.delete(l)
    array.clear(gLines)
    for lb in gLabels
        label.delete(lb)
    array.clear(gLabels)
    if not na(gFill)
        linefill.delete(gFill)
    if not na(kLo) and not na(kHi)
        lLo = f_level(gLines, gLabels, kLo, "коридор дня · низ " + f_px(kLo), color.new(color.teal, 0), line.style_dashed)
        lHi = f_level(gLines, gLabels, kHi, "коридор дня · верх " + f_px(kHi), color.new(color.teal, 0), line.style_dashed)
        gFill := linefill.new(lLo, lHi, color.new(color.teal, 94))
    for [i, p] in zp
        c = array.get(zc, i)
        f_level(gLines, gLabels, p, (p >= close ? "↑ зона " : "↓ зона ") + f_px(p) + (na(c) ? "" : " · шанс " + str.tostring(c, "0") + "%"), color.new(color.fuchsia, 0), line.style_dotted)
    if array.size(ent) > 0
        for p in ent
            f_level(gLines, gLabels, p, "", color.new(color.lime, 40), line.style_dotted)
        array.push(gLabels, label.new(bar_index + 2, array.min(ent), "входы сеток: " + str.tostring(array.size(ent)) + " (" + f_span(ent) + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.lime, size=size.small))
    if showTp and array.size(tps) > 0
        for p in tps
            f_level(gLines, gLabels, p, "", color.new(color.red, 40), line.style_dotted)
        array.push(gLabels, label.new(bar_index + 2, array.min(tps), "ближайшие тейки: " + str.tostring(array.size(tps)) + " (" + f_span(tps) + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.red, size=size.small))
    if not na(aAvg)
        f_level(gLines, gLabels, aAvg, "безубыток лотов " + f_px(aAvg) + " · цена " + f_pct((close / aAvg - 1) * 100), color.new(color.yellow, 0), line.style_solid)

    // таблица
    msLeft = 86400000 - timenow % 86400000
    hh     = math.floor(msLeft / 3600000)
    mm     = math.floor((msLeft % 3600000) / 60000)
    thrCol = na(dThr) ? color.silver : math.abs(dThr) < warnPct ? color.red : math.abs(dThr) < 2 * warnPct ? color.orange : color.lime
    table.cell(T, 0, 0, "bot7 · режим", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small, text_halign=text.align_left)
    src0 = not isBot ? "дневки графика · ботов нет" : srcMode == "авто" ? sym + " · дневки UTC" : "дневки графика (у ботов — BINANCE спот)"
    table.cell(T, 1, 0, src0, text_color=color.silver, bgcolor=color.new(color.black, 20), text_size=size.small, text_halign=text.align_left)
    regTxt = na(ySma) ? "мало истории" : isBot ? (regUp ? "ЛОНГ — сетки работают" : "ВНЕ РЫНКА — лонгов нет") : (regUp ? "выше SMA" : "ниже SMA")
    f_row(T, 1, "Режим ботов", regTxt, na(ySma) ? color.silver : regUp ? color.lime : color.gray)
    f_row(T, 2, "SMA" + str.tostring(smaLen) + " дн.", f_px(ySma) + " · цена " + f_pct(dSma), color.white)
    sameDay = not na(u) and math.floor(u / 86400) == math.floor(timenow / 86400000)
    botDiff = sameDay and not na(sThr) and not na(thr) and math.abs(sThr / thr - 1) > 0.001
    k3 = isBot ? (regUp ? "Закрытие дня НИЖЕ" : "Закрытие дня ВЫШЕ") : "Порог закрытия дня"
    v3 = f_px(thr) + " (" + f_pct(dThr) + ")" + (isBot ? (regUp ? " → лонги закроются" : " → лонги вкл") : "") + (botDiff ? " ⚠ у бота " + f_px(sThr) : "")
    f_row(T, 3, k3, v3, botDiff ? color.orange : thrCol)
    gap = na(thr) ? na : math.abs(close - thr)
    f_row(T, 4, "Запас до порога", na(gap) or na(atrD) or atrD <= 0 ? "—" : f_px(gap) + " = " + str.tostring(gap / atrD, "0.0") + " дневных размаха (ATR " + f_px(atrD) + ")", thrCol)
    f_row(T, 5, "До закрытия дня UTC", isBot ? str.tostring(hh) + "ч " + str.tostring(mm) + "м" : "—", color.white)
    if not na(kLo) and not na(kHi) and kHi > kLo
        inPct = (close - kLo) / (kHi - kLo) * 100
        f_row(T, 6, "Коридор дня", f_px(kLo) + "–" + f_px(kHi) + " · цена на " + str.tostring(inPct, "0") + "%", inPct < 0 or inPct > 100 ? color.orange : color.teal)
    else
        f_row(T, 6, "Коридор дня", isBot ? "нет: /tv в Telegram → ⚙ индикатора → «Строка из бота»" : "—", color.gray)
    lotTxt = na(nLot) ? "—" : str.tostring(nLot, "0") + " лот." + (na(aAvg) ? "" : " · безубыток " + f_px(aAvg) + " (цена " + f_pct((close / aAvg - 1) * 100) + ")")
    f_row(T, 7, "Лоты бота", lotTxt, color.yellow)
    ageH = na(u) ? na : (timenow / 1000 - u) / 3600
    ageTxt = na(ageH) ? (isBot ? "строки нет" : "—") : ageH < 1 ? str.tostring(math.round(ageH * 60)) + " мин назад" : str.tostring(ageH, "0.0") + " ч назад"
    f_row(T, 8, "Уровни бота от", ageTxt, na(ageH) ? color.gray : ageH > 12 ? color.orange : color.white)

alertcondition(near, "bot7: близко к порогу", "Цена близко к порогу закрытия дня по SMA100 — лонг-сетки могут закрыться на следующий день")
alertcondition(flipOn or flipOff, "bot7: смена режима", "Сменился режим SMA100 у сеток")
