//@version=5
// GRID REGIME DASHBOARD v5.7 — финал ядра (точная спека Win grid-$). Mac+Win, 2026-06-07.
// GATE (валидировано, +155/+100/+9 в окнах чоп/цикл/крах): чистая ЦЕНА vs TEMA200 (красная), БЕЗ стека.
//   long allow  = close > красная*(1 - band%);  short allow = close < красная*(1 + band%);  hold confBars.
// СЕМАНТИКА = OPEN-STOP: контр-нога = ПАУЗА НОВЫХ ордеров (STOP-IN), существующие доживают до target,
//   НЕ закрываются. Force-close ("режь") = ХУЖE (реализует убыток на флипах). close_mask=None.
// VOL-OFF (z>=2.5) = СОВЕТНИК, НЕ авто-рез: авто-cut-both net-отрицателен (2024 +155→−84 — стреляет
//   на не-крах вол-спайках). Решение «авто vs человек vs counter-only» — за оператором (см. флаг).
// HEALTH/follow-through = ТОЛЬКО направленная/no-edge нога, НЕ грид (Win #3). IB закрыт (anchor-fragile).
// Причинно: алерты на barstate.isconfirmed. Пресет TEMA.
indicator("Grid Regime Dashboard v5.7", overlay=true, max_labels_count=500, max_lines_count=20)

// ---------------- INPUTS ----------------
gT = "MA / preset"
useEma = input.bool(false, "EMA вместо TEMA (выкл = TEMA, рекоменд.)", group=gT)
lenF   = input.int(50,  "MA fast",  group=gT, minval=2)
lenM   = input.int(100, "MA mid",   group=gT, minval=2)
lenS   = input.int(200, "MA slow (красная) = GATE", group=gT, minval=2)

gR = "ЯДРО грида (price vs TEMA200, OPEN-STOP, валид. grid-$)"
band     = input.float(0.3, "GATE band % от красной (long: >красная−band; short: <красная+band)", group=gR, step=0.1)
confBars = input.int(2, "Hold N баров (дебаунс, Win=2)", group=gR, minval=1)

gOff = "Vol off-switch (СОВЕТНИК, не авто-рез)"
volMode = input.string("Советник (алерт)", "vol-off действие", options=["Советник (алерт)", "Авто: режь контр-ногу", "Авто: режь ОБЕ (net−!)"], group=gOff,
     tooltip="Win grid-$: авто-режь-ОБЕ = net-отрицателен (2024 +155→−84). Дефолт = советник.")
atrLen    = input.int(14,  "ATR length", group=gOff)
volZlen   = input.int(100, "Vol z lookback", group=gOff)
volZon    = input.float(2.5, "Vol-expansion ON (z>=)", group=gOff, step=0.1)
volZoff   = input.float(1.0, "Vol-expansion OFF (z<)", group=gOff, step=0.1)
crashRush = input.float(4.0, "Crash: рывок за 1 бар % >", group=gOff, step=0.5)
crashAtrX = input.float(1.4, "Crash: ATR% > x медианы", group=gOff, step=0.1)

gFT = "Follow-through health — ТОЛЬКО направленная/no-edge нога, НЕ ГРИД!"
ftConfirm = input.int(60, "health >= → ПОДТВЕРЖДАЕТСЯ", group=gFT)
ftFizzle  = input.int(40, "health <= K баров → ЗАТУХАЕТ", group=gFT)
ftBars    = input.int(1, "K баров затухания (Win sweep: 1)", group=gFT, minval=1)

gE = "Entry add-on (инфо-маркеры)"
freshDist = input.float(4.0, "Confirmed-flip 'чистый' dist красной % <", group=gE, step=0.5)
volMult   = input.float(1.3, "Confirmed-flip: объём > x SMA", group=gE, step=0.1)
rsiLen    = input.int(14, "RSI len", group=gE)
pbDist    = input.float(3.0, "Пуллбэк: dist красной % <=", group=gE, step=0.1)
pbRsiMax  = input.float(10.0, "Пуллбэк: |RSI-50| <=", group=gE, step=1.0)

gX = "КОНТЕКСТ (инфо, бот НЕ торгует)"
useCtx     = input.bool(true,  "Показать КОНТЕКСТ", group=gX)
oiTicker   = input.string("",  "OI тикер (пусто=выкл)", group=gX)
fundTicker = input.string("",  "Funding тикер (пусто=выкл)", group=gX)
showLiq    = input.bool(true,  "Свинг-уровни ликвидности", group=gX)
liqLen     = input.int(15, "Свинг pivot N", group=gX, minval=2)

gD = "Display"
showRibbon = input.bool(true, "Show MA lines", group=gD)
showBG     = input.bool(true, "Mode background", group=gD)
markerMode = input.string("All", "Markers", options=["All","Entries only","None"], group=gD)

// ---------------- MA / RSI ----------------
ma(len) =>
    e1 = ta.ema(close, len)
    e2 = ta.ema(e1, len)
    e3 = ta.ema(e2, len)
    useEma ? e1 : 3 * e1 - 3 * e2 + e3
t50  = ma(lenF)
t100 = ma(lenM)
t200 = ma(lenS)
rsi   = ta.rsi(close, rsiLen)
rsiMa = ta.sma(rsi, 9)

// ---------------- Vol off-switch + crash (СОВЕТНИК) ----------------
atrp = ta.atr(atrLen) / close * 100.0
volZ = (atrp - ta.sma(atrp, volZlen)) / ta.stdev(atrp, volZlen)
var bool volExp = false
volExp := volZ >= volZon ? true : (volZ < volZoff ? false : volExp)
atrMed = ta.median(atrp, volZlen)
rush1  = math.abs(close / close[1] - 1) * 100.0
crash  = rush1 > crashRush and atrp > crashAtrX * atrMed
volWarn = volExp or crash

// ---------------- Stack (только для health/инфо, НЕ для гейта) ----------------
bullStack = t50 > t100 and t100 > t200
bearStack = t50 < t100 and t100 < t200
spreadPct = math.abs(t50 - t200) / close * 100.0
aboveRedPct = (close - t200) / t200 * 100.0
distSlow = math.abs(aboveRedPct)

// ---------------- GATE: price vs TEMA200, OPEN-STOP, hold confBars ----------------
rawLong  = close > t200 * (1 - band / 100.0)
rawShort = close < t200 * (1 + band / 100.0)
var int lOn = 0
var int lOff = 0
var int sOn = 0
var int sOff = 0
lOn  := rawLong  ? lOn + 1 : 0
lOff := rawLong  ? 0 : lOff + 1
sOn  := rawShort ? sOn + 1 : 0
sOff := rawShort ? 0 : sOff + 1
var bool longOK = true
var bool shortOK = true
if lOn >= confBars
    longOK := true
else if lOff >= confBars
    longOK := false
if sOn >= confBars
    shortOK := true
else if sOff >= confBars
    shortOK := false

regDir = (longOK and shortOK) ? 0 : longOK ? 1 : -1
mode = regDir == 1 ? "UP" : regDir == -1 ? "DN" : "FLAT"
longState  = longOK  ? "ON" : "STOP-IN"
shortState = shortOK ? "ON" : "STOP-IN"
action = regDir == 1 ? "АПТРЕНД — LONG ON / SHORT стоп-IN (доживают)" : regDir == -1 ? "ДАУНТРЕНД — SHORT ON / LONG стоп-IN (доживают)" : "FLAT — ОБЕ ноги ON (харвест чопа)"
// vol-off совет по выбранному режиму
volAdvice = not volWarn ? "—" : volMode == "Авто: режь ОБЕ (net−!)" ? "АВТО: пауза/режь ОБЕ" : volMode == "Авто: режь контр-ногу" ? "АВТО: режь контр-ногу" : "СОВЕТ: краш→пауза/хедж; ложный спайк→игнор"
regChanged = regDir != regDir[1]
volOnset = volWarn and not volWarn[1]

// ---------------- Entry markers (инфо) ----------------
volRatio = nz(volume / ta.sma(volume, volZlen))
volOk    = na(volume) or volRatio > volMult
enterLong  = regDir == 1  and regDir[1] != 1
enterShort = regDir == -1 and regDir[1] != -1
cleanLong  = enterLong  and rsi > rsiMa and volOk and distSlow < freshDist
cleanShort = enterShort and rsi < rsiMa and volOk and distSlow < freshDist
pbLong  = regDir == 1  and distSlow <= pbDist and math.abs(rsi - 50) <= pbRsiMax and close <= t100
pbShort = regDir == -1 and distSlow <= pbDist and math.abs(rsi - 50) <= pbRsiMax and close >= t100

// ---------------- FOLLOW-THROUGH health (ТОЛЬКО направленная нога) ----------------
bodyUp = close > open
rng = high - low
closeStr = rng > 0 ? (close - low) / rng : 0.5
volPart = volRatio > 1.0
ftBull = (close > t50 ? 25 : 0) + (close > t100 ? 15 : 0) + (close > t200 ? 10 : 0) + (bodyUp ? 20 : 0) + (volPart ? 15 : 0) + (closeStr > 0.6 ? 15 : 0)
ftBear = (close < t50 ? 25 : 0) + (close < t100 ? 15 : 0) + (close < t200 ? 10 : 0) + (not bodyUp ? 20 : 0) + (volPart ? 15 : 0) + (closeStr < 0.4 ? 15 : 0)
ftHealth = regDir == 1 ? ftBull : regDir == -1 ? ftBear : na
var float entryStrength = na
if enterLong or enterShort
    entryStrength := regDir == 1 ? ftBull : ftBear
ftVerdict = na(ftHealth) ? "—" : ftHealth >= ftConfirm ? "ПОДТВЕРЖДАЕТСЯ" : ftHealth <= ftFizzle ? "ЗАТУХАЕТ" : "вяло"
var int ftLowCnt = 0
ftLowCnt := (not na(ftHealth) and ftHealth <= ftFizzle) ? ftLowCnt + 1 : 0
fizzle = not na(ftHealth) and ftLowCnt >= ftBars

// ---------------- КОНТЕКСТ (инфо) ----------------
oiTk   = oiTicker   == "" ? syminfo.tickerid : oiTicker
fundTk = fundTicker == "" ? syminfo.tickerid : fundTicker
oiRaw   = request.security(oiTk,   timeframe.period, close, ignore_invalid_symbol=true)
fundRaw = request.security(fundTk, timeframe.period, close, ignore_invalid_symbol=true)
oiVal   = oiTicker   == "" ? na : oiRaw
fundVal = fundTicker == "" ? na : fundRaw
ph = ta.pivothigh(liqLen, liqLen)
pl = ta.pivotlow(liqLen, liqLen)
var float lastPH = na
var float lastPL = na
lastPH := na(ph) ? lastPH : ph
lastPL := na(pl) ? lastPL : pl

// ---------------- Plots ----------------
plot(showRibbon ? t50  : na, "MA fast", color.new(color.lime,   0), 1)
plot(showRibbon ? t100 : na, "MA mid",  color.new(color.yellow, 0), 2)
plot(showRibbon ? t200 : na, "TEMA200 (GATE)", color.new(color.red, 0), 2)
bgCol = mode == "UP" ? color.new(color.green, 88) : mode == "DN" ? color.new(color.red, 88) : color.new(color.gray, 92)
bgcolor(showBG ? bgCol : na)
bgcolor(showBG and volWarn ? color.new(color.orange, 80) : na)

showEntries = markerMode != "None"
showExtras  = markerMode == "All"
eLcol = cleanLong  ? color.new(color.lime, 0) : color.new(color.gray, 0)
eScol = cleanShort ? color.new(color.red,  0) : color.new(color.gray, 0)
plotshape(showEntries and enterLong,  "UP (short stop-IN)",  shape.triangleup,   location.belowbar, eLcol, size=size.small, text="L")
plotshape(showEntries and enterShort, "DN (long stop-IN)",   shape.triangledown, location.abovebar, eScol, size=size.small, text="S")
plotshape(showEntries and pbLong,     "Pullback LONG", shape.circle,       location.belowbar, color.new(color.aqua,   0), size=size.tiny, text="pb")
plotshape(showEntries and pbShort,    "Pullback SHORT",shape.circle,       location.abovebar, color.new(color.fuchsia,0), size=size.tiny, text="pb")
plotshape(showExtras  and fizzle,     "FIZZLE (напр.)",shape.square,       location.abovebar, color.new(color.purple,0), size=size.tiny, text="fz")
plotshape(showExtras  and volOnset,   "VOL-OFF спайк", shape.xcross,       location.abovebar, color.new(color.orange,0), size=size.small, text="vol")

var line liqHiLine = na
var line liqLoLine = na
if barstate.islast
    line.delete(liqHiLine)
    line.delete(liqLoLine)
    if showLiq and not na(lastPH)
        liqHiLine := line.new(bar_index - 80, lastPH, bar_index + 3, lastPH, xloc=xloc.bar_index, color=color.new(color.red, 45),   style=line.style_dotted)
    if showLiq and not na(lastPL)
        liqLoLine := line.new(bar_index - 80, lastPL, bar_index + 3, lastPL, xloc=xloc.bar_index, color=color.new(color.green, 45), style=line.style_dotted)

// ---------------- DASHBOARD (table) ----------------
cON = color.new(color.green, 0)
cStop = color.new(color.orange, 0)
longCol  = longOK  ? cON : cStop
shortCol = shortOK ? cON : cStop
modeCol = mode == "UP" ? color.green : mode == "DN" ? color.red : color.gray
ftCol = na(ftHealth) ? color.gray : ftHealth >= ftConfirm ? color.green : ftHealth <= ftFizzle ? color.red : color.orange
stackTxt = bullStack ? "BULL" : bearStack ? "BEAR" : "mixed"
hdr = color.new(color.blue, 30)
var table tb = table.new(position.top_right, 2, 16, border_width=1)
if barstate.islast
    table.cell(tb, 0, 0, "ЯДРО ГРИДА — бот торгует", text_color=color.white, bgcolor=hdr)
    table.cell(tb, 1, 0, "v5.7", text_color=color.silver, bgcolor=hdr)
    table.cell(tb, 0, 1, "ДЕЙСТВИЕ", text_color=color.white, bgcolor=color.new(color.black,0))
    table.cell(tb, 1, 1, action, text_color=color.white, bgcolor=color.new(modeCol, 35))
    table.cell(tb, 0, 2, "LONG-грид (инверс)", text_color=color.silver)
    table.cell(tb, 1, 2, longState, text_color=color.white, bgcolor=longCol)
    table.cell(tb, 0, 3, "SHORT-грид (линейка)", text_color=color.silver)
    table.cell(tb, 1, 3, shortState, text_color=color.white, bgcolor=shortCol)
    table.cell(tb, 0, 4, "VOL-OFF", text_color=color.silver)
    table.cell(tb, 1, 4, volWarn ? volAdvice : "спокойно", text_color=color.white, bgcolor=volWarn ? color.new(color.orange,20) : color.new(color.green,60))
    table.cell(tb, 0, 5, "РЕЖИМ", text_color=color.silver)
    table.cell(tb, 1, 5, mode, text_color=color.white, bgcolor=color.new(modeCol, 50))
    table.cell(tb, 0, 6, "цена vs красной %", text_color=color.silver)
    table.cell(tb, 1, 6, str.tostring(aboveRedPct, "#.##"), text_color=color.white)
    table.cell(tb, 0, 7, "стек / spread %", text_color=color.silver)
    table.cell(tb, 1, 7, stackTxt + " / " + str.tostring(spreadPct, "#.##"), text_color=color.white)
    table.cell(tb, 0, 8, "ATR% / Vol-z", text_color=color.silver)
    table.cell(tb, 1, 8, str.tostring(atrp, "#.##") + " / " + str.tostring(volZ, "#.##") + (volWarn ? " !" : ""), text_color=volWarn ? color.orange : color.white)
    table.cell(tb, 0, 9, "— напр. нога (НЕ грид) —", text_color=color.white, bgcolor=color.new(color.purple,40))
    table.cell(tb, 1, 9, "инфо", text_color=color.silver, bgcolor=color.new(color.purple,40))
    table.cell(tb, 0, 10, "сила входа", text_color=color.silver)
    table.cell(tb, 1, 10, na(entryStrength) ? "—" : str.tostring(entryStrength, "#") + "/100", text_color=color.white)
    table.cell(tb, 0, 11, "follow-through", text_color=color.silver)
    table.cell(tb, 1, 11, (na(ftHealth) ? "—" : str.tostring(ftHealth, "#") + "/100 ") + ftVerdict, text_color=color.white, bgcolor=color.new(ftCol, 55))
    table.cell(tb, 0, 12, useCtx ? "— КОНТЕКСТ (инфо) —" : "", text_color=color.white, bgcolor=useCtx ? color.new(color.gray,20) : color.new(color.black,100))
    table.cell(tb, 1, 12, "", bgcolor=useCtx ? color.new(color.gray,20) : color.new(color.black,100))
    table.cell(tb, 0, 13, useCtx ? "OI / Funding" : "", text_color=color.silver)
    table.cell(tb, 1, 13, useCtx ? ((na(oiVal) ? "n/a" : str.tostring(oiVal, "#.##")) + " / " + (na(fundVal) ? "n/a" : str.tostring(fundVal, "#.####"))) : "", text_color=color.gray)
    table.cell(tb, 0, 14, useCtx ? "ликвид hi / lo" : "", text_color=color.silver)
    table.cell(tb, 1, 14, useCtx ? (str.tostring(lastPH, "#.0") + " / " + str.tostring(lastPL, "#.0")) : "", text_color=color.gray)
    table.cell(tb, 0, 15, "", text_color=color.silver)
    table.cell(tb, 1, 15, "", text_color=color.gray)

// ---------------- Alerts (причинно: barstate.isconfirmed) ----------------
alertcondition(regChanged and barstate.isconfirmed, "Режим изменился", "Grid gate flip (STOP-IN side changed)")
alertcondition(enterLong  and barstate.isconfirmed, "UP — SHORT стоп-IN", "Regime UP: pause new shorts")
alertcondition(enterShort and barstate.isconfirmed, "DN — LONG стоп-IN", "Regime DN: pause new longs")
alertcondition(volOnset and barstate.isconfirmed, "VOL-OFF спайк (СОВЕТ)", "Vol-off spike — оцени: краш или ложный")
alertcondition(fizzle and barstate.isconfirmed, "FIZZLE (направл. нога, НЕ грид)", "Follow-through fizzle — directional leg only")
if (regChanged or volOnset) and barstate.isconfirmed
    alert('{"ind":"grid_regime","sym":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","long":"' + longState + '","short":"' + shortState + '","regime":"' + mode + '","voloff":' + (volWarn ? "true" : "false") + ',"price_vs_red":' + str.tostring(aboveRedPct, "#.##") + '}', alert.freq_once_per_bar)
