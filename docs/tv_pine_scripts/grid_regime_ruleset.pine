//@version=5
// GRID REGIME RULESET v4 — preset (По данным / Твой) + TREND/FLAT + markers + vol off
// Mac 2026-06-06. First-cross of the line is best (82/2); confirm/buffer/slow-line worsen it.
indicator("Grid Regime Ruleset v4", overlay=true, max_labels_count=500)

// ---------------- INPUTS ----------------
gT="Preset & lines"
preset=input.string("Твой: EMA + красная(200)","ПРЕСЕТ",options=["Твой: EMA + красная(200)","По данным: TEMA + жёлтая(100)"],group=gT)
lenF=input.int(50,"MA fast",group=gT,minval=2)
lenM=input.int(100,"MA mid (жёлтая)",group=gT,minval=2)
lenS=input.int(200,"MA slow (красная)",group=gT,minval=2)
flipBuf=input.float(0.0,"Flip buffer % (0 = first cross = best)",group=gT,step=0.1)
gReg="Trend / Flat"
flatThr=input.float(1.0,"FLAT если разлёт риббона % ниже",group=gReg,step=0.1)
gV="Vol off-switch (hysteresis)"
atrLen=input.int(14,"ATR length",group=gV)
volZlen=input.int(100,"Vol z lookback",group=gV)
volZon=input.float(2.5,"Vol-expansion ON (z>=)",group=gV,step=0.1)
volZoff=input.float(1.0,"Vol-expansion OFF (z<)",group=gV,step=0.1)
gR="Window-risk"
atrRisk=input.float(1.0,"ATR% risky above",group=gR,step=0.05)
spreadRisk=input.float(1.4,"Ribbon spread risky above %",group=gR,step=0.1)
redRisk=input.float(0.5,"Adverse-candle frac risky >=",group=gR,step=0.05)
earlyBars=input.int(12,"Early-cut after N bars",group=gR)
earlyAdv=input.float(0.5,"Early-cut adverse move % >",group=gR,step=0.1)
gD="Display"
showRibbon=input.bool(true,"Show MA lines",group=gD)
showBG=input.bool(true,"Mode background",group=gD)
markerMode=input.string("All","Markers",options=["All","Entries only","None"],group=gD)

// ---------------- MA lines (preset-driven) ----------------
isYours = preset=="Твой: EMA + красная(200)"
ma(len,useEma)=>
    e1=ta.ema(close,len)
    e2=ta.ema(e1,len)
    e3=ta.ema(e2,len)
    useEma ? e1 : 3*e1-3*e2+e3
t50=ma(lenF,isYours)
t100=ma(lenM,isYours)
t200=ma(lenS,isYours)

atrp=ta.atr(atrLen)/close*100.0
volZ=(atrp-ta.sma(atrp,volZlen))/ta.stdev(atrp,volZlen)
var bool volExp=false
volExp := volZ>=volZon ? true : (volZ<volZoff ? false : volExp)

bullStack=t50>t100 and t100>t200
bearStack=t50<t100 and t100<t200
spreadPct=math.abs(t50-t200)/close*100.0
aligned = bullStack or bearStack
regime = aligned and spreadPct>=flatThr ? "TREND" : "FLAT"

refLine = isYours ? t200 : t100
var int dir=0
if close > refLine*(1+flipBuf/100)
    dir := 1
else if close < refLine*(1-flipBuf/100)
    dir := -1
longWin = dir==1
shortWin= dir==-1
mode = volExp ? "VOL-OFF" : longWin ? "LONG" : shortWin ? "SHORT" : "FLAT"
enterLong = longWin and not longWin[1]
enterShort= shortWin and not shortWin[1]

// ---------------- WINDOW-RISK score ----------------
redCnt = math.sum(close<open ? 1.0 : 0.0, earlyBars)
redFrac= redCnt/earlyBars
advFracL = redFrac
advFracS = 1.0-redFrac
riskAt(adv,_atr,_spr)=> (_atr>atrRisk?1:0)+(_spr>spreadRisk?1:0)+(adv>=redRisk?1:0)
var int winRisk=0
var float winStart=na
var int winBar=na
var string winSide="-"
var bool cutFired=false
if enterLong
    winRisk := riskAt(advFracL,atrp,spreadPct)
    winStart := close
    winBar := bar_index
    winSide := "long"
    cutFired := false
if enterShort
    winRisk := riskAt(advFracS,atrp,spreadPct)
    winStart := close
    winBar := bar_index
    winSide := "short"
    cutFired := false
riskTxt = winRisk>=3?"HIGH":winRisk==2?"MED":"LOW"
riskCol = winRisk>=3?color.red:winRisk==2?color.yellow:color.lime

// ---------------- EARLY-CUT ----------------
inWin = longWin or shortWin
barsIn = inWin ? bar_index-winBar : 0
advMove = na(winStart) ? 0.0 : (winSide=="short" ? close/winStart-1 : winStart/close-1)*100.0
earlyCut = inWin and barsIn>=earlyBars and advMove>earlyAdv and not cutFired
if earlyCut
    cutFired := true

// ---------------- Exits (bot STOPS here) ----------------
exitShort = shortWin[1] and ta.crossover(close,refLine)
exitLong  = longWin[1]  and ta.crossunder(close,refLine)

// ---------------- Plots ----------------
plot(showRibbon?t50 :na,"MA fast",color.new(color.lime,0),1)
plot(showRibbon?t100:na,"MA mid (жёлтая)", color.new(color.yellow,0),2)
plot(showRibbon?t200:na,"MA slow (красная)",color.new(color.red,0),1)
bgCol = mode=="VOL-OFF"?color.new(color.orange,80):mode=="LONG"?color.new(color.green,90):mode=="SHORT"?color.new(color.red,90):color.new(color.gray,92)
bgcolor(showBG?bgCol:na)
showEntries = markerMode!="None"
showExtras  = markerMode=="All"
eLcol = winRisk>=3?color.new(color.red,0):winRisk==2?color.new(color.orange,0):color.new(color.lime,0)
eScol = winRisk>=3?color.new(color.red,0):winRisk==2?color.new(color.orange,0):color.new(color.aqua,0)
plotshape(showEntries and enterLong, "Open LONG",  shape.triangleup,  location.belowbar, eLcol, size=size.small, text="L")
plotshape(showEntries and enterShort,"Open SHORT", shape.triangledown,location.abovebar, eScol, size=size.small, text="S")
plotshape(showExtras and earlyCut,  "EARLY-CUT", shape.xcross, location.abovebar, color.fuchsia, size=size.small, text="cut")
plotshape(showExtras and exitShort, "STOP short", shape.xcross, location.belowbar, color.new(color.aqua,20),    size=size.tiny)
plotshape(showExtras and exitLong,  "STOP long",  shape.xcross, location.abovebar, color.new(color.fuchsia,20), size=size.tiny)

// ---------------- Table ----------------
modeCol = mode=="VOL-OFF"?color.orange:mode=="LONG"?color.green:mode=="SHORT"?color.red:color.gray
gaAct = volExp ? "PAUSE / cut / hedge" : regime=="FLAT" ? "SYMMETRIC grid (chop)" : longWin ? "LONG directional grid" : "SHORT directional grid"
var table tb=table.new(position.top_right,2,7,border_width=1)
if barstate.islast
    table.cell(tb,0,0,"ПРЕСЕТ",text_color=color.silver)
    table.cell(tb,1,0,isYours?"Твой EMA/красная":"По данным TEMA/жёлтая",text_color=color.white)
    table.cell(tb,0,1,"MODE",text_color=color.white,bgcolor=color.new(color.black,0))
    table.cell(tb,1,1,mode,text_color=color.white,bgcolor=modeCol)
    table.cell(tb,0,2,"Regime",text_color=color.silver)
    table.cell(tb,1,2,regime,text_color=color.white,bgcolor=regime=="TREND"?color.new(color.blue,50):color.new(color.gray,50))
    table.cell(tb,0,3,"Window risk",text_color=color.silver)
    table.cell(tb,1,3,riskTxt+" ("+str.tostring(winRisk)+"/3)",text_color=color.white,bgcolor=color.new(riskCol,60))
    table.cell(tb,0,4,"GinArea",text_color=color.silver)
    table.cell(tb,1,4,gaAct,text_color=color.white,bgcolor=color.new(modeCol,70))
    table.cell(tb,0,5,"ATR% / spread",text_color=color.silver)
    table.cell(tb,1,5,str.tostring(atrp,"#.##")+" / "+str.tostring(spreadPct,"#.##"),text_color=color.white)
    table.cell(tb,0,6,"Vol z",text_color=color.silver)
    table.cell(tb,1,6,str.tostring(volZ,"#.##")+(volExp?" !":""),text_color=volExp?color.orange:color.white)

// ---------------- Alerts ----------------
alertcondition(enterLong, "Open LONG", "Open LONG grid")
alertcondition(enterShort,"Open SHORT","Open SHORT grid")
alertcondition(earlyCut,  "EARLY-CUT","Adverse move - stop/cut grid")
alertcondition(volExp,    "VOL-EXPANSION","ATR spike - pause/cut/hedge")
