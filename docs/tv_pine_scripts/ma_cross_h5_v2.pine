//@version=5
// MA CROSS H5 v2 — индикатор уклона грид-книги. База: EMA 14/77 hl2 4ч.
// Свод Win+Mac (2026-06-13): ядро H5 валидировано дважды — Win (BitMEX) + Mac (Binance):
//   H5 net +117/+118пп, DD ~22%. Как переключатель уклона бьёт MA100-свитч на BTC/ETH/SOL
//   (GRID_LEAN_H5_vs_MA100_WIN_2026-06-13.md). Фильтры: наклон EMA77 + сторона EMA200 + анти-whipsaw.
// ПРАВКИ Win vs черновика v2 Мака: (1) синтаксис — по одному var/присваиванию на строку (Pine не ест
//   запятую). (2) Эллиотт-строка (импульс/коррекция) = ТОЛЬКО ОТОБРАЖЕНИЕ, НЕ гейтит сигнал, и она
//   BTC-ONLY: multi-symbol проверка (ELLIOTT_IMPULSE_MULTISYM_WIN) — на ETH инверсия, на SOL шум.
//   На ETH/SOL ⚠«коррекция» ИГНОРИРОВАТЬ. Переносимый конвикшн-уклон = РАСТЯЖКА, не импульс.
indicator("MA Cross H5 v2 (EMA 14/77/200 + Elliott диспл.)", overlay=true, max_labels_count=500)

src      = input.source(hl2, "Цена (валидировано: hl2)")
lenF     = input.int(14,  "EMA fast", minval=2)
lenS     = input.int(77,  "EMA slow", minval=2)
lenR     = input.int(200, "EMA режим (фильтр)", minval=2)
slopeN   = input.int(5,   "Наклон slow: баров", minval=1)
whipN    = input.int(4,   "Whipsaw: прошлая нога <= баров -> пропуск", minval=1)
zzLen    = input.int(5,   "ZigZag pivot (Эллиотт, BTC-only диспл.): баров", minval=2)
showSkip = input.bool(true, "Показывать пропущенные кроссы (с причиной)")
showTab  = input.bool(true, "Таблица уклона (справа сверху)")

emaF = ta.ema(src, lenF)
emaS = ta.ema(src, lenS)
emaR = ta.ema(src, lenR)

crossUp = ta.crossover(emaF, emaS)
crossDn = ta.crossunder(emaF, emaS)
anyCross = crossUp or crossDn

slopeUp = emaS > emaS[slopeN]
slopeDn = emaS < emaS[slopeN]
regUp   = close > emaR
regDn   = close < emaR
prevLeg = nz(ta.barssince(anyCross)[1], 9999) + 1
whipOk  = prevLeg > whipN

longSig  = crossUp and slopeUp and regUp and whipOk
shortSig = crossDn and slopeDn and regDn and whipOk

// растяжка от EMA77 (переносимый конвикшн-уклон, фаза-4): больше = сильнее вход на ВСЕХ 3 символах
stretchPct = math.abs(close - emaS) / close * 100.0

// Эллиотт (ТОЛЬКО ДИСПЛЕЙ, BTC-only): импульс = свинги монотонно трендят (HH+HL / LH+LL)
ph = ta.pivothigh(high, zzLen, zzLen)
pl = ta.pivotlow(low, zzLen, zzLen)
var float ph1 = na
var float ph2 = na
var float pl1 = na
var float pl2 = na
if not na(ph)
    ph2 := ph1
    ph1 := ph
if not na(pl)
    pl2 := pl1
    pl1 := pl
impUp     = not na(ph1) and not na(ph2) and not na(pl1) and not na(pl2) and ph1 > ph2 and pl1 > pl2
impDn     = not na(ph1) and not na(ph2) and not na(pl1) and not na(pl2) and ph1 < ph2 and pl1 < pl2
isImpulse = impUp or impDn

reason(up) =>
    r = ""
    if (up and not slopeUp) or (not up and not slopeDn)
        r := "наклон"
    if (up and not regUp) or (not up and not regDn)
        r := r == "" ? "режим" : r + "+режим"
    if not whipOk
        r := r == "" ? "whip" : r + "+whip"
    r

var int pos = 0
if longSig
    pos := 1
else if shortSig
    pos := -1
else if anyCross
    pos := 0

plot(emaF, "EMA 14", color.new(color.lime, 0), 1)
plot(emaS, "EMA 77", color.new(color.yellow, 0), 2)
plot(emaR, "EMA 200", color.new(color.red, 0), 1)
bgcolor(pos == 1 ? color.new(color.green, 90) : pos == -1 ? color.new(color.red, 90) : na)

plotshape(longSig  and barstate.isconfirmed, "LONG",  shape.triangleup,   location.belowbar, color.new(color.lime, 0), size=size.normal, text="L")
plotshape(shortSig and barstate.isconfirmed, "SHORT", shape.triangledown, location.abovebar, color.new(color.red, 0),  size=size.normal, text="S")
if showSkip and anyCross and not longSig and not shortSig and barstate.isconfirmed
    label.new(bar_index, crossUp ? low : high, "✗ " + reason(crossUp), style=crossUp ? label.style_label_up : label.style_label_down, color=color.new(color.gray, 60), textcolor=color.silver, size=size.small)

// Таблица уклона (текущее состояние глазами)
var table t = table.new(position.top_right, 2, 5, border_width=1)
if showTab and barstate.islast
    leanTxt = pos == 1 ? "LONG ▲" : pos == -1 ? "SHORT ▼" : "НЕЙТРАЛ ="
    leanCol = pos == 1 ? color.lime : pos == -1 ? color.red : color.gray
    ma100   = close > ta.sma(close, 100) ? "LONG" : "SHORT"
    isBTC   = str.contains(syminfo.ticker, "BTC") or str.contains(syminfo.ticker, "XBT")
    ewTxt   = (isImpulse ? "импульс ✅" : "коррекция ⚠") + (isBTC ? "" : " (BTC-only)")
    strTxt  = str.tostring(stretchPct, "#.##") + "%"
    table.cell(t, 0, 0, "H5 УКЛОН", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 0, leanTxt, text_color=leanCol, bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 1, "растяжка EMA77", text_color=color.silver, bgcolor=color.new(color.black, 50))
    table.cell(t, 1, 1, strTxt, text_color=color.aqua, bgcolor=color.new(color.black, 50))
    table.cell(t, 0, 2, "Эллиотт (диспл.)", text_color=color.silver, bgcolor=color.new(color.black, 50))
    table.cell(t, 1, 2, ewTxt, text_color=isBTC ? (isImpulse ? color.lime : color.orange) : color.gray, bgcolor=color.new(color.black, 50))
    table.cell(t, 0, 3, "старый MA100", text_color=color.silver, bgcolor=color.new(color.black, 50))
    table.cell(t, 1, 3, ma100, text_color=color.silver, bgcolor=color.new(color.black, 50))
    table.cell(t, 0, 4, "TF", text_color=color.silver, bgcolor=color.new(color.black, 50))
    table.cell(t, 1, 4, timeframe.period, text_color=timeframe.period == "240" ? color.lime : color.orange, bgcolor=color.new(color.black, 50))

alertcondition(longSig,  "H5 LONG",  "MA-Cross H5: LONG (кросс+наклон+режим+чисто)")
alertcondition(shortSig, "H5 SHORT", "MA-Cross H5: SHORT")
alertcondition(anyCross and not (longSig or shortSig), "H5 EXIT/SKIP", "Кросс без подтверждения: выход/пропуск")
