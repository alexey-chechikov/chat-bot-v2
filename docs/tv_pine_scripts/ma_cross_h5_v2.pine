//@version=5
// MA CROSS H5 v2 (2026-06-13) — индикатор уклона грид-книги. База: EMA 14/77 hl2 4ч.
// Валидировано ДВАЖДЫ: Win (BitMEX 2г, BTC/ETH/SOL) + Mac (Binance, второй движок): H5 net
//   +117/+118пп, DD ~22%, фильтры реплицировались на другой бирже. H5-уклон бьёт старый
//   MA100-свитч на всех 3 (на SOL MA100 был −31/DD107). +Слой Эллиотта (Mac): импульс vs
//   коррекция отделяет +2.98% от −1.10% даже после фильтров — добавлен как ОТТЕНОК (не гейт).
// Фильтры входа H5: 1) наклон EMA77 по кроссу; 2) цена на стороне EMA200; 3) анти-whipsaw
//   (прошлая нога >4 баров). Выход = обратный кросс 14×77. Ставить на 4ч таймфрейм.
indicator("MA Cross H5 v2 (EMA 14/77/200 + Elliott)", overlay=true, max_labels_count=500)

src      = input.source(hl2, "Цена (валидировано: hl2)")
lenF     = input.int(14,  "EMA fast", minval=2)
lenS     = input.int(77,  "EMA slow", minval=2)
lenR     = input.int(200, "EMA режим (фильтр)", minval=2)
slopeN   = input.int(5,   "Наклон slow: баров", minval=1)
whipN    = input.int(4,   "Whipsaw: прошлая нога <= баров -> пропуск", minval=1)
zzLen    = input.int(5,   "ZigZag pivot (Эллиотт): баров", minval=2)
showSkip = input.bool(true, "Показывать пропущенные кроссы (с причиной)")
showTab  = input.bool(true, "Таблица уклона (справа сверху)")

emaF = ta.ema(src, lenF)
emaS = ta.ema(src, lenS)
emaR = ta.ema(src, lenR)

crossUp = ta.crossover(emaF, emaS)
crossDn = ta.crossunder(emaF, emaS)
anyCross = crossUp or crossDn

slopeUp = emaS > emaS[slopeN]
slopeDn = emaS < emaS[slopeN]
regUp   = close > emaR
regDn   = close < emaR
prevLeg = nz(ta.barssince(anyCross)[1], 9999) + 1
whipOk  = prevLeg > whipN

longSig  = crossUp and slopeUp and regUp and whipOk
shortSig = crossDn and slopeDn and regDn and whipOk

// ── Эллиотт: импульс (свинги монотонно трендят HH+HL / LH+LL) vs коррекция (перекрытие)
ph = ta.pivothigh(high, zzLen, zzLen)
pl = ta.pivotlow(low, zzLen, zzLen)
var float h1 = na, var float h2 = na
var float l1 = na, var float l2 = na
if not na(ph)
    h2 := h1, h1 := ph
if not na(pl)
    l2 := l1, l1 := pl
impUp   = not na(h1) and not na(h2) and not na(l1) and not na(l2) and h1 > h2 and l1 > l2
impDn   = not na(h1) and not na(h2) and not na(l1) and not na(l2) and h1 < h2 and l1 < l2
isImpulse = impUp or impDn

reason(up) =>
    r = ""
    if (up and not slopeUp) or (not up and not slopeDn)
        r := "наклон"
    if (up and not regUp) or (not up and not regDn)
        r := r == "" ? "режим" : r + "+режим"
    if not whipOk
        r := r == "" ? "whip" : r + "+whip"
    r

var int pos = 0
if longSig
    pos := 1
else if shortSig
    pos := -1
else if anyCross
    pos := 0

plot(emaF, "EMA 14", color.new(color.lime, 0), 1)
plot(emaS, "EMA 77", color.new(color.yellow, 0), 2)
plot(emaR, "EMA 200", color.new(color.red, 0), 1)
bgcolor(pos == 1 ? color.new(color.green, 90) : pos == -1 ? color.new(color.red, 90) : na)

plotshape(longSig  and barstate.isconfirmed, "LONG",  shape.triangleup,   location.belowbar, color.new(color.lime, 0), size=size.normal, text="L")
plotshape(shortSig and barstate.isconfirmed, "SHORT", shape.triangledown, location.abovebar, color.new(color.red, 0),  size=size.normal, text="S")
if showSkip and anyCross and not longSig and not shortSig and barstate.isconfirmed
    label.new(bar_index, crossUp ? low : high, "✗ " + reason(crossUp),
              style=crossUp ? label.style_label_up : label.style_label_down,
              color=color.new(color.gray, 60), textcolor=color.silver, size=size.small)

// ── Таблица уклона (текущее состояние глазами)
if showTab and barstate.islast
    var table t = table.new(position.top_right, 2, 4, border_width=1)
    leanTxt = pos == 1 ? "LONG ▲" : pos == -1 ? "SHORT ▼" : "НЕЙТРАЛ ="
    leanCol = pos == 1 ? color.lime : pos == -1 ? color.red : color.gray
    ma100   = close > ta.sma(close, 100) ? "LONG" : "SHORT"
    ewTxt   = isImpulse ? "импульс ✅" : "коррекция ⚠"
    table.cell(t, 0, 0, "H5 УКЛОН", text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 0, leanTxt, text_color=leanCol, bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 1, "Эллиотт", text_color=color.silver, bgcolor=color.new(color.black, 50))
    table.cell(t, 1, 1, ewTxt, text_color=isImpulse ? color.lime : color.orange, bgcolor=color.new(color.black, 50))
    table.cell(t, 0, 2, "старый MA100", text_color=color.silver, bgcolor=color.new(color.black, 50))
    table.cell(t, 1, 2, ma100, text_color=color.silver, bgcolor=color.new(color.black, 50))
    table.cell(t, 0, 3, "TF", text_color=color.silver, bgcolor=color.new(color.black, 50))
    table.cell(t, 1, 3, timeframe.period, text_color=timeframe.period == "240" ? color.lime : color.orange, bgcolor=color.new(color.black, 50))

alertcondition(longSig,  "H5 LONG",  "MA-Cross H5: LONG (кросс+наклон+режим+чисто)")
alertcondition(shortSig, "H5 SHORT", "MA-Cross H5: SHORT")
alertcondition(anyCross and not (longSig or shortSig), "H5 EXIT/SKIP", "Кросс без подтверждения: выход/пропуск")
