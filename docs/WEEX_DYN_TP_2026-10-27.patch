diff --git a/tests/research_weex/test_rw_orphan_check_window.py b/tests/research_weex/test_rw_orphan_check_window.py
new file mode 100644
index 0000000..25ece76
--- /dev/null
+++ b/tests/research_weex/test_rw_orphan_check_window.py
@@ -0,0 +1,38 @@
+"""research/weex/orphan_check.py при окне динамических тейков (27.10, engine.tp_window): лот без тейка, которому до тейка
+больше окна, спит — не находка; ближе окна без тейка — находка, как раньше; негодное окно — находка (сетка стоит)."""
+from tests.research_weex.harness import FakeClient, make_grid, run_script, side_state
+
+
+def sleeping_state():
+    lot = {"entry": 100.0, "qty": "1", "tp": 101.0, "t": 1.0, "tp_order": None}
+    return {"symbol": "BTCUSDT", "LONG": side_state(lots=[lot]), "SHORT": side_state(), "halted": False}
+
+
+def run(tmp_path, monkeypatch, book, **cfg):
+    make_grid(tmp_path, monkeypatch, cfg={"release_sides": [], "target_pct": 0.5, **cfg}, st=sleeping_state(),
+              journal=[])
+    return run_script("orphan_check.py", FakeClient(book=book), monkeypatch)
+
+
+def test_lot_beyond_window_sleeps_not_finding(tmp_path, monkeypatch):
+    code, out = run(tmp_path, monkeypatch, (98.0, 98.0), tp_arm_pct=2.0, tp_park_pct=3.0)   # до тейка 3.06%
+    assert code == 0, out
+    assert "спят по окну 2/3%: 1" in out and "лот без тейка" not in out
+
+
+def test_lot_inside_window_without_tp_is_finding(tmp_path, monkeypatch):
+    code, out = run(tmp_path, monkeypatch, (100.0, 100.0), tp_arm_pct=2.0, tp_park_pct=3.0)  # до тейка 1%
+    assert code == 1, out
+    assert "лот без тейка" in out and "окно 2%" in out
+
+
+def test_no_window_lot_without_tp_is_finding(tmp_path, monkeypatch):
+    code, out = run(tmp_path, monkeypatch, (98.0, 98.0))
+    assert code == 1, out
+    assert "лот без тейка" in out and "спят" not in out
+
+
+def test_broken_window_is_finding(tmp_path, monkeypatch):
+    code, out = run(tmp_path, monkeypatch, (98.0, 98.0), tp_arm_pct=0.2, tp_park_pct=3.0)   # окно меньше цели
+    assert code == 1, out
+    assert "сетка стоит" in out and "лот без тейка" in out
diff --git a/tests/services/weex_grid/test_weex_dyn_tp.py b/tests/services/weex_grid/test_weex_dyn_tp.py
new file mode 100644
index 0000000..4c96e89
--- /dev/null
+++ b/tests/services/weex_grid/test_weex_dyn_tp.py
@@ -0,0 +1,402 @@
+"""27.10: окно динамических тейков (engine.tp_window). Оператор: «давай разрабатывать динамические ордера … минусы о них
+я в курсе, но теперешний вариант тоже меня не устраивает» — 27.10 все пять сеток стояли без входов («бюджет заявок счёта
+185 из 185»), из 173 тейков ближе 2% к цене было 60. Тейк дальше park % от цены снимается — лот спит без заявки на
+бирже; цене до тейка не больше arm % — тейк ставится снова. Снятие учитывает исполненное до снятия и забывает тейк только
+на подтверждённом конечном статусе; спящий лот — не долг по выходам; закрытие по режиму закрывает и спящие лоты."""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from services.weex_grid import engine as eg
+
+LIVE = eg.LIVE
+
+
+class MovePx:
+    def __init__(self, p: float = 100000.0):
+        self.p = p
+
+    def __call__(self):
+        return self.p - 0.05, self.p + 0.05
+
+
+class Ex(eg.DryExchange):
+    """Имитатор: отмена снимает и частично исполненный; гонки — подменённая деталь, отмена, которая ещё не прошла,
+    отказ тейка (лимит заявок счёта)."""
+
+    def __init__(self, *a, **kw):
+        super().__init__(*a, **kw)
+        self.info_override: dict[str, dict] = {}
+        self.lazy_cancel = False
+        self.reject_tp = False
+        self.cancels: list[str] = []
+
+    def cancel(self, oid):
+        self.cancels.append(str(oid))
+        o = self.orders.get(str(oid))
+        if not self.lazy_cancel and o and o["status"] in ("NEW", "PARTIALLY_FILLED"):
+            o["status"] = "CANCELED"
+        return {"success": True, "orderId": oid}
+
+    def order_info(self, oid):
+        if str(oid) in self.info_override:
+            return self.info_override[str(oid)]
+        return super().order_info(oid)
+
+    def place_limit(self, symbol, side, position_side, qty, price, cid, reduce_only=False, post_only=True):
+        if self.reject_tp and reduce_only:
+            return {"success": False, "errorCode": "SYNTHETIC_ACCOUNT_ORDER_CAP", "orderId": None}
+        return super().place_limit(symbol, side, position_side, qty, price, cid, reduce_only, post_only)
+
+
+def make(tmp_path, side="LONG", ex=None, px=None, regime_fn=None, **cfg):
+    px = px or MovePx()
+    clock = {"t": 1_800_000_000.0}
+    ex = ex or Ex(px, now_fn=lambda: clock["t"])
+    conf = {**eg.DEFAULT, "enabled": True, "dry_run": True, "sides": [side], "step_pct": 0.6, "target_pct": 1.4,
+            "order_qty": "0.0012", "max_notional_usd": 100000.0, "max_lots_per_side": 50,
+            "daily_loss_stop_usd": 0.0, "stress_budget_frac": 0.0,          # как у живых сеток: выключены
+            "tp_arm_pct": 2.0, "tp_park_pct": 3.0, **cfg}
+
+    def now():
+        clock["t"] += 10
+        return clock["t"]
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    g = eg.Grid(ex, conf, state_path=tmp_path / "st.json", journal_path=tmp_path / "j.jsonl", now_fn=now,
+                regime_fn=regime_fn)
+    return g, ex, px
+
+
+def move(g, px, to, pct=0.3):
+    """Цена шагами по pct % к to, проход на каждом шаге (входы и тейки исполняются по одному)."""
+    while abs(px.p - to) > 1e-9:
+        px.p = max(to, px.p * (1 - pct / 100)) if to < px.p else min(to, px.p * (1 + pct / 100))
+        g.tick()
+
+
+def at_dist(px, tp, dist, side="LONG"):
+    """Цена, при которой до тейка ровно dist % (лонг — от bid вверх, шорт — от ask вниз)."""
+    px.p = tp / (1 + dist / 100) + 0.05 if side == "LONG" else tp / (1 - dist / 100) - 0.05
+
+
+def tps(ex, side="LONG"):
+    return [o for o in ex.orders.values() if o["reduceOnly"] and o["status"] in LIVE and o["positionSide"] == side]
+
+
+def entries(ex):
+    return [o for o in ex.orders.values() if not o["reduceOnly"] and o["status"] in LIVE]
+
+
+def journal(tmp_path):
+    p = tmp_path / "j.jsonl"
+    return [json.loads(x) for x in p.read_text(encoding="utf-8").splitlines()] if p.exists() else []
+
+
+def one_lot(tmp_path, **cfg):
+    """Сетка с одним лотом (вход 99 400, тейк 100 791.6) и его тейком на бирже."""
+    g, ex, px = make(tmp_path, max_lots_per_side=1, **cfg)
+    g.tick()
+    px.p = 99399.0
+    g.tick()
+    g.tick()
+    lot = g.st["LONG"]["lots"][0]
+    assert lot["tp_order"] is not None and len(tps(ex)) == 1
+    return g, ex, px, lot
+
+
+# ---------------------------------------------------------------- конфиг
+@pytest.mark.parametrize("arm,park,target,want", [
+    (0, 0, 1.4, None),
+    (2, 3, 1.4, (2.0, 3.0)),
+    (1.4, 1.5, 1.4, (1.4, 1.5)),
+    (None, None, 1.4, None),
+])
+def test_window_valid(arm, park, target, want):
+    assert eg.tp_window({"tp_arm_pct": arm, "tp_park_pct": park, "target_pct": target}) == want
+
+
+@pytest.mark.parametrize("arm,park", [(1, 3), (2, 2), (3, 2), (2, 0), (0, 3), (2, 60), (float("nan"), 3), ("x", 3)])
+def test_window_invalid_halts_grid(tmp_path, arm, park):
+    """Негодное окно — ConfigError (сетка встаёт), а не выключенное окно по умолчанию."""
+    with pytest.raises(eg.ConfigError):
+        eg.tp_window({"tp_arm_pct": arm, "tp_park_pct": park, "target_pct": 1.4})
+    with pytest.raises(eg.ConfigError):
+        make(tmp_path, tp_arm_pct=arm, tp_park_pct=park)
+
+
+def test_distance_sides():
+    assert eg.tp_distance("LONG", 102.0, 100.0, 100.1) == pytest.approx(2.0)
+    assert eg.tp_distance("SHORT", 98.0, 99.9, 100.0) == pytest.approx(2.0)
+    assert eg.tp_distance("LONG", 99.0, 100.0, 100.1) < 0          # цена уже за тейком
+
+
+# ---------------------------------------------------------------- основное поведение
+def test_far_tps_sleep_near_tps_stand_and_entries_go_on(tmp_path):
+    g, ex, px = make(tmp_path)
+    g.tick()
+    move(g, px, 95000.0)
+    g.tick()
+    lots = g.st["LONG"]["lots"]
+    assert len(lots) == 8
+    bid, ask = px()
+    sleeping = [l for l in lots if eg.tp_distance("LONG", l["tp"], bid, ask) > 3.0]
+    near = [l for l in lots if eg.tp_distance("LONG", l["tp"], bid, ask) <= 2.0]
+    assert sleeping and near
+    assert all(l["tp_order"] is None for l in sleeping)
+    assert all(l["tp_order"] is not None for l in near)
+    live = tps(ex)
+    assert len(live) == sum(1 for l in lots if l["tp_order"]) < len(lots)
+    assert {o["origQty"] for o in live} == {"0.0012"}
+    assert g.st["exit_debt"]["LONG"] == 0                       # спящие — не долг
+    assert len(entries(ex)) == 1 and not g.st["LONG"]["blocked"]
+    assert g.st["LONG"]["tp_parks"] == len(sleeping)
+    assert not g.st["LONG"]["strays"]
+
+
+def test_rise_rearms_and_closes_sleeping_lots_at_their_tp(tmp_path):
+    g, ex, px = make(tmp_path)
+    g.tick()
+    move(g, px, 95000.0)
+    g.tick()
+    top = max(g.st["LONG"]["lots"], key=lambda l: l["entry"])
+    assert top["tp_order"] is None
+    move(g, px, top["tp"] * 1.002)
+    assert not g.st["LONG"]["lots"]                             # все закрыты тейками
+    rows = [r for r in journal(tmp_path) if r.get("kind") == "тейк"]
+    assert len(rows) == 8
+    for r in rows:                                              # каждый — по своей цене тейка, в плюс
+        assert r["price"] == pytest.approx(eg.round_tick(r["entry"] * 1.014, 0.1, up=True))
+        assert r["pnl"] > 0
+    assert g.st["LONG"]["realized"] == pytest.approx(sum(r["pnl"] for r in rows))
+
+
+def test_hysteresis_between_arm_and_park(tmp_path):
+    g, ex, px, lot = one_lot(tmp_path)
+    at_dist(px, lot["tp"], 3.5)
+    g.tick()
+    lot = g.st["LONG"]["lots"][0]
+    assert lot["tp_order"] is None and tps(ex) == [] and g.st["LONG"]["tp_parks"] == 1
+    at_dist(px, lot["tp"], 2.5)                                 # между окнами: спящий так и спит
+    g.tick()
+    assert g.st["LONG"]["lots"][0]["tp_order"] is None and tps(ex) == []
+    at_dist(px, lot["tp"], 1.9)                                 # ближе arm — тейк ставится
+    g.tick()
+    live = tps(ex)
+    assert len(live) == 1 and live[0]["origQty"] == "0.0012" and float(live[0]["price"]) == pytest.approx(lot["tp"])
+    at_dist(px, lot["tp"], 2.8)                                 # между окнами: стоящий так и стоит
+    g.tick()
+    assert len(tps(ex)) == 1 and g.st["LONG"]["tp_parks"] == 1
+    at_dist(px, lot["tp"], 3.2)                                 # дальше park — снова спит
+    g.tick()
+    assert tps(ex) == [] and g.st["LONG"]["tp_parks"] == 2
+
+
+def test_partial_fill_before_park_is_booked_and_rest_rearmed(tmp_path):
+    g, ex, px, lot = one_lot(tmp_path)
+    oid = lot["tp_order"]["id"]
+    ex.orders[oid].update(status="PARTIALLY_FILLED", executedQty="0.0005", avgPrice=str(lot["tp"]))
+    at_dist(px, lot["tp"], 3.5)
+    g.tick()
+    lot = g.st["LONG"]["lots"][0]
+    assert lot["qty"] == "0.0007" and lot["tp_order"] is None
+    assert g.st["LONG"]["realized"] == pytest.approx(0.0005 * (lot["tp"] - lot["entry"]))
+    assert [r["kind"] for r in journal(tmp_path) if "тейк" in str(r.get("kind"))] == ["тейк (часть)"]
+    at_dist(px, lot["tp"], 1.5)
+    g.tick()
+    live = tps(ex)
+    assert len(live) == 1 and live[0]["origQty"] == "0.0007"   # новый тейк — ровно на остаток
+    assert g.st["exit_debt"]["LONG"] == 0
+
+
+def test_unknown_detail_after_cancel_keeps_tp_until_confirmed(tmp_path):
+    g, ex, px, lot = one_lot(tmp_path)
+    oid = lot["tp_order"]["id"]
+    ex.info_override[oid] = {}                                  # пустой ответ детали
+    at_dist(px, lot["tp"], 3.5)
+    g.tick()
+    lot = g.st["LONG"]["lots"][0]
+    assert lot["tp_order"] and lot["tp_order"]["id"] == oid     # неясно — тейк не забыт
+    assert oid in g.st.get("unknown_orders", {})
+    g.tick()
+    assert g.st["LONG"]["lots"][0]["tp_order"]["id"] == oid
+    del ex.info_override[oid]                                   # биржа ответила: CANCELED
+    g.tick()
+    assert g.st["LONG"]["lots"][0]["tp_order"] is None
+    assert sum(1 for o in ex.orders.values() if o["reduceOnly"]) == 1   # второго тейка не ставилось
+    assert not g.st["LONG"]["strays"] and g.st["exit_debt"]["LONG"] == 0
+
+
+def test_cancel_not_yet_done_keeps_tp_no_duplicate(tmp_path):
+    g, ex, px, lot = one_lot(tmp_path)
+    oid = lot["tp_order"]["id"]
+    ex.lazy_cancel = True                                       # отмена ещё не прошла — ордер жив
+    at_dist(px, lot["tp"], 3.5)
+    g.tick()
+    g.tick()
+    assert g.st["LONG"]["lots"][0]["tp_order"]["id"] == oid and len(tps(ex)) == 1
+    ex.lazy_cancel = False
+    g.tick()
+    assert g.st["LONG"]["lots"][0]["tp_order"] is None and tps(ex) == []
+    assert sum(1 for o in ex.orders.values() if o["reduceOnly"]) == 1
+
+
+def test_tp_filled_in_race_with_park_is_booked_not_parked(tmp_path):
+    """Тейк исполнился (фитиль), пока окно его снимало: деталь после отмены — FILLED: лот закрыт, прибыль учтена."""
+    g, ex, px, lot = one_lot(tmp_path)
+    oid = lot["tp_order"]["id"]
+    ex.lazy_cancel = True
+    ex.info_override[oid] = {"orderId": oid, "status": "FILLED", "executedQty": "0.0012", "avgPrice": str(lot["tp"]),
+                             "positionSide": "LONG", "symbol": "BTCUSDT"}
+    at_dist(px, lot["tp"], 3.5)
+    g.tick()
+    ex.orders[oid].update(status="FILLED", executedQty="0.0012", avgPrice=str(lot["tp"]))
+    assert g.st["LONG"]["lots"] == []
+    assert g.st["LONG"]["realized"] == pytest.approx(0.0012 * (lot["tp"] - lot["entry"]))
+    assert [r["kind"] for r in journal(tmp_path) if "тейк" in str(r.get("kind"))] == ["тейк"]
+
+
+def test_park_batch_limit_farthest_first(tmp_path):
+    """Включение окна на сетке с длинной лесенкой: за проход снимается не больше TP_PARK_BATCH тейков, дальние первыми."""
+    off, ex, px = make(tmp_path / "a", step_pct=0.3, target_pct=0.6, tp_arm_pct=0, tp_park_pct=0)
+    off.tick()
+    move(off, px, 92000.0, pct=0.15)
+    n = len(off.st["LONG"]["lots"])
+    assert n >= 25 and len(tps(ex)) == n                        # окно выключено: тейк у каждого лота
+    g, _, _ = make(tmp_path / "a", ex=ex, px=px, step_pct=0.3, target_pct=0.6, tp_arm_pct=1.0, tp_park_pct=1.5)
+    bid, ask = px()
+    far = sorted(g.st["LONG"]["lots"], key=lambda l: -eg.tp_distance("LONG", l["tp"], bid, ask))
+    n_far = sum(1 for l in far if eg.tp_distance("LONG", l["tp"], bid, ask) > 1.5)
+    assert n_far > eg.TP_PARK_BATCH
+    g.tick()
+    lots = sorted(g.st["LONG"]["lots"], key=lambda l: -eg.tp_distance("LONG", l["tp"], bid, ask))
+    assert [l["tp_order"] is None for l in lots[:eg.TP_PARK_BATCH]] == [True] * eg.TP_PARK_BATCH
+    assert sum(1 for l in lots if l["tp_order"] is None) == eg.TP_PARK_BATCH
+    assert g.st["exit_debt"]["LONG"] == 0
+    g.tick()
+    g.tick()
+    assert sum(1 for l in g.st["LONG"]["lots"] if l["tp_order"] is None) == n_far
+    assert len(tps(ex)) == n - n_far
