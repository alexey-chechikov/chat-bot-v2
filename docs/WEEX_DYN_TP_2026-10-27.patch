+def tp_window(cfg: dict) -> tuple[float, float] | None:
+    """Окно динамических тейков (27.10, оператор: «давай разрабатывать динамические ордера … теперешний вариант тоже
+    меня не устраивает»; 27.10 все пять сеток стояли без входов — «бюджет заявок счёта 185 из 185», из 173 тейков
+    ближе 2% к цене было 60). (arm, park) в % или None — окно выключено, тейк каждого лота стоит на бирже, как было.
+    Лот без тейка получает его, когда цене до тейка не больше arm %; стоящий тейк снимается, когда до него больше park %
+    (гистерезис: между arm и park ничего не меняется). arm не меньше цели — тейк только что купленного лота ставится
+    сразу. Негодно (не число, arm < цели, park ≤ arm, > 50 %, задан один из двух) — ConfigError: сетка встаёт,
+    умолчания не подставляются."""
+    try:
+        arm = float(cfg.get("tp_arm_pct") or 0)
+        park = float(cfg.get("tp_park_pct") or 0)
+        target = float(cfg.get("target_pct") or 0)
+    except (TypeError, ValueError) as exc:
+        raise ConfigError(f"окно тейков негодно: {exc}") from exc
+    if not (math.isfinite(arm) and math.isfinite(park)):
+        raise ConfigError(f"окно тейков {arm!r}/{park!r}: не конечное число")
+    if arm == 0 and park == 0:
+        return None
+    if not (0 < target <= arm < park <= 50):
+        raise ConfigError(f"окно тейков {arm:g}/{park:g}% негодно: нужно цель ({target:g}%) ≤ поставить < снять ≤ 50%")
+    return arm, park
+
+
+def tp_distance(side: str, tp: float, bid: float, ask: float) -> float:
+    """Сколько % цене идти до тейка лота: лонг — от bid вверх, шорт — от ask вниз; ≤ 0 — цена уже за тейком."""
+    ref = bid if side == "LONG" else ask
+    return DIR[side] * (float(tp) - ref) / ref * 100
