+def test_tp_repairs_in_same_pass_count_against_budget(tmp_path):
+    """Перепроверка GPT 25.10: 184 заявки → в этом же проходе ремонт трёх тейков → вход был разрешён по счётчику начала
+    прохода (188 > 185). Теперь каждая отправка прохода увеличивает счётчик символа."""
+    g, ex, px = make(tmp_path)
+    g.tick()                                                    # вход
+    px.p = 99300.0
+    g.tick()
+    px.p = 98700.0
+    g.tick()
+    px.p = 98100.0
+    g.tick()                                                    # три лота с тейками
+    lots = g.st["LONG"]["lots"]
+    assert len(lots) == 3
+    for lot in lots:                                            # тейки «пропали» — их надо поставить заново
+        oid = lot["tp_order"]["id"]
+        ex.orders[oid]["status"] = "CANCELED"
+        lot["tp_order"] = None
+    g.save()
+    entry = g.st["LONG"].get("entry")
+    if entry:
+        ex.orders[entry["id"]]["status"] = "CANCELED"
+        g.st["LONG"]["entry"] = None
+        g.save()
+    g.cfg.update(order_budget=185, other_open_orders=184)      # до прохода: 0 своих открытых + 184 на счёте
+    g.tick()
+    tps = [o for o in ex.orders.values() if o["reduceOnly"] and o["status"] in LIVE]
+    assert len(tps) == 3                                        # тейки бюджетом не режутся
+    assert entries_live(ex) == [] and "бюджет заявок счёта" in g.st["LONG"]["blocked"]
+
