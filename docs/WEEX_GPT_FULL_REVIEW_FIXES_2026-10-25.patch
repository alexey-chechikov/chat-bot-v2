+def test_state_does_not_depend_on_window_start():
+    """Перепроверка GPT 25.10: старт гистерезиса «x > SMA» в первый день окна внутри полосы давал LONG→FLAT при
+    неизменной цене, когда старое пересечение выпадало из окна. Теперь отсчёт — с первого закрытия вне полосы:
+    итог одинаков при любом окне, где такое закрытие есть; нет ни одного — режим неизвестен (не FLAT)."""
+    import random
+    rnd = random.Random(7)
+    walk, p = [], 100.0
+    for _ in range(1200):
+        p *= 1 + rnd.gauss(0, 0.02)
+        walk.append(p)
+    for cut in (500, 700, 1000):                            # то же «сегодня», разная длина истории
+        eg._REGIME_CACHE.clear()
+        got = eg.regime_up("X", 100, now=NOW, fetch=lambda s, n: rows(walk[-cut:]), band_pct=2.0)
+        if cut == 500:
+            ref = got
+        assert got == ref
+    flat = [100.0 + i * 0.5 for i in range(200)] + [200.0] * 700     # выше SMA+2% давно, потом цена стоит у SMA
+    eg._REGIME_CACHE.clear()
+    assert eg.regime_up("X", 100, now=NOW, fetch=lambda s, n: rows(flat[-500:]), band_pct=2.0) is None
+    recent = [100.0 + i * 0.5 for i in range(200)] + [200.0] * 350   # рост ещё в окне 500 дней — состояние определено
+    eg._REGIME_CACHE.clear()
+    assert eg.regime_up("X", 100, now=NOW, fetch=lambda s, n: rows(recent), band_pct=2.0) is True
+
+
